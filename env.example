# Шаблон настроек бота. Скопируйте файл в .env и подставьте свои значения.
# Реальные .env и credentials.json в git не попадают.

# Telegram
BOT_TOKEN=токен_бота_от_BotFather
ADMIN_CHAT_ID=id_чата_администратора

# Google Sheets
SPREADSHEET_ID=id_таблицы_из_ссылки_в_браузере
GOOGLE_CREDENTIALS_FILE=credentials.json

# Автомойка
TIMEZONE=Europe/Moscow
CARWASH_NAME=название_мойки
CARWASH_ADDRESS=адрес_для_клиентов_можно_пусто
CARWASH_PHONE=телефон_для_клиентов_можно_пусто
CURRENCY=₽

# Поведение
MIN_LEAD_MINUTES=30
CATALOG_CACHE_SEC=60
SLOTS_CACHE_SEC=15
MAX_HISTORY=24

# Основной AI-провайдер (OpenAI-совместимый API)
LLM_BASE_URL=адрес_API_провайдера
LLM_MODEL=имя_модели
LLM_API_KEY=ключ_API

# Резервные провайдеры (необязательно, до трёх; переключение при сбоях/квоте)
#LLM_FALLBACK_1_BASE_URL=адрес_резервного_API
#LLM_FALLBACK_1_API_KEY=ключ_резервного_API
#LLM_FALLBACK_1_MODEL=имя_резервной_модели

# Названия листов таблицы (по умолчанию: Услуги, Тарифы, Слоты, Записи, Классы)
#SHEET_SERVICES=Услуги
#SHEET_TARIFFS=Тарифы
#SHEET_SLOTS=Слоты
#SHEET_BOOKINGS=Записи
#SHEET_CLASSES=Классы

# Только отдельный локальный бот; общий токен команды не использовать.
BOT_TOKEN=
LOCAL_BOT_ID=
BOT_START_CONFIRMED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json
ADMIN_CHAT_ID=
TIMEZONE=Europe/Moscow
CARWASH_NAME=АвтоМойка
CARWASH_ADDRESS=
CARWASH_PHONE=
CURRENCY=₽
MIN_LEAD_MINUTES=30
CATALOG_CACHE_SEC=60
SLOTS_CACHE_SEC=15
MAX_HISTORY=24
SHEET_SERVICES=Услуги
SHEET_TARIFFS=Тарифы
SHEET_SLOTS=Слоты
SHEET_BOOKINGS=Записи
SHEETS_ADAPTIVE_ENABLED=false
SHEETS_DISCOVER_ON_START=false
SHEETS_SCHEMA_CHECK_INTERVAL_HOURS=24
SHEETS_AI_MAPPING_ENABLED=false
SHEETS_FORCE_SCHEMA_REFRESH=false
SHEETS_MAPPING_FILE=.runtime/sheets-mapping.json

# Совместимый Chat Completions API. Пустые AI_API_KEY / AI_MODEL используют OPENROUTER_*.
AI_ENABLED=true
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SEC=60
# Пусто — параметр reasoning_effort вообще не передаётся.
AI_REASONING_EFFORT=
AI_REASONING_SUPPORTED=false
# Пустое значение убирает temperature для моделей без его поддержки.
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=1024
AI_TOKEN_LIMIT_PARAMETER=max_tokens
AI_MAX_TOOL_ITERATIONS=6
AI_MAX_TOOL_CALLS=12
AI_REQUEST_RETRIES=1
AI_RECENT_TURNS=4
AI_HISTORY_CHARS=6000
AI_PROOFREAD_ENABLED=false
# Сброс неактивной памяти и предел числа сессий; активные запросы не удаляются.
AI_SESSION_TTL_SEC=3600
AI_MAX_SESSIONS=1000
# Необязательные отдельные адрес, ключ и модель только для подсказок по заголовкам.
SHEETS_AI_BASE_URL=
SHEETS_AI_API_KEY=
SHEETS_AI_MODEL=
SHEETS_AI_JSON_MODE=true
